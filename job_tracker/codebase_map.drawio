        <mxCell id="audit_note" value="Both files share the schema:&#xa;| Timestamp | Action | Date | Company | Title | Source | Status | Contact | Follow-up | Notes |&#xa;&#xa;_archive_row() writes only here, with f.flush() + os.fsync() — destruction is gated on archive success." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="sw_audit_box">
          <mxGeometry x="15" y="195" width="350" height="150" as="geometry" />
        </mxCell>

        <!-- Backups (rotating snapshots) -->
        <mxCell id="s_backup_box" value="BACKUP — rotating snapshots (capped at MAX_BACKUPS=200)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bae6fd;strokeColor=#0284c7;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="sw_storage">
          <mxGeometry x="820" y="50" width="380" height="360" as="geometry" />
        </mxCell>
        <mxCell id="s_snap_dir" value="backup/tracker_snapshots/&#xa;~6 files · pruned to most-recent 200&#xa;filename pattern:&#xa;job_applications_YYYYMMDD_HHMMSS_ffffff.md" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#0284c7;fontSize=10;" vertex="1" parent="sw_backup_box">
          <mxGeometry x="15" y="35" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_backup_logic" value="_backup_tracker_file() runs BEFORE every write_tracker().&#xa;&#xa;1. shutil.copy2(TRACKER_FILE → snapshots/) — timestamped&#xa;2. _prune_old_backups() — sort + remove excess&#xa;&#xa;Failure mode: best-effort, never blocks a sanity-checked write,&#xa;but raises loud if the snapshots directory itself is unwritable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0ea5e9;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="sw_backup_box">
          <mxGeometry x="15" y="115" width="350" height="130" as="geometry" />
        </mxCell>

