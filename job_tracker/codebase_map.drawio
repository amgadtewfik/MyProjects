        <mxCell id="g_handler" value="TrackerHandler(BaseHTTPRequestHandler)&#xa;• do_GET — GET /, /api/applications, /api/pending-jobs&#xa;• do_POST — /api/applications {application, index}&#xa;• do_DELETE — /api/applications {index}&#xa;• add_security_headers: CSP frame-ancestors 'none', X-Frame-Options DENY, X-Content-Type-Options nosniff&#xa;• send_json_error(code, message) — never raises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=10;fontStyle=1;" vertex="1" parent="sw_gateway">
          <mxGeometry x="20" y="180" width="600" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g_methods" value="Methods&#xa;• read_tracker() → {applications, activeApplications, rejectedApplications, lastUpdated}&#xa;• update_tracker(app, index) → archive + write_tracker&#xa;• delete_application(index) → archive + write_tracker&#xa;• write_tracker(apps) → backup → tmp → fsync → verify → os.replace&#xa;• _backup_tracker_file() / _prune_old_backups() — keeps MAX_BACKUPS=200&#xa;• _archive_row(path, app, action) — append-only tombstone w/ fsync&#xa;• _parse_tracker_content(content) — shared markdown table parser&#xa;• log_error(exc) — append traceback to server.log, never raises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="sw_gateway">
